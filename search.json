---
layout: null
sitemap: false
---
[
{%- for post in site.posts %}
{%- assign cat = post.categories | first %}
{"t":{{ post.title | jsonify }},"u":{{ post.url | relative_url | jsonify }},"d":{{ post.date | date: "%Y-%m-%d" | jsonify }},"c":{{ site.data.categories[cat].name | default: cat | jsonify }},"g":{{ post.tags | join: " " | jsonify }},"x":{{ post.description | default: "" | jsonify }},"b":{{ post.content | strip_html | normalize_whitespace | truncatewords: 250, "" | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
